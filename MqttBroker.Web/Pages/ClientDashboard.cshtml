@page
@model MqttBroker.Web.Pages.ClientDashboardModel
@{
    ViewData["Title"] = "Client Dashboard";
}

<h2>Welcome</h2>



<h3>Your Subscriptions:</h3>
<input type="text" id="subscribedSearch" placeholder="Search subscribed topics..." onkeyup="filterSubscribed()" />


<div id="subscribedList" class="topic-list">
    @foreach (var topic in Model.SubscribedTopics)
    {
        <div class="topic-card">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <a asp-page="/ViewTopic" asp-route-topic="@topic">@topic</a>
                <form method="post" style="display: inline;">
                    <input type="hidden" name="TopicName" value="@topic" />
                    <button type="submit" name="Action" value="unsubscribe">Unsubscribe</button>
                </form>
            </div>
        </div>
    }
</div>

<hr />

<h3>Available Topics (from Neo4j):</h3>
<input type="text" id="topicSearch" placeholder="Search available topics..." onkeyup="filterAvailable()" />

<div id="topicList" class="topic-list">
    @foreach (var topic in Model.AvailableTopics.Except(Model.SubscribedTopics))
    {
        <div class="topic-card">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <a asp-page="/ViewTopic" asp-route-topic="@topic">@topic</a>
                <form method="post" style="display: inline;">
                    <input type="hidden" name="TopicName" value="@topic" />
                    <button type="submit" name="Action" value="subscribe">Subscribe</button>
                </form>
            </div>
        </div>
    }
</div>

<style>
    input#subscribedSearch {
        padding: 10px;
        margin-bottom: 15px;
        width: 100%;
        max-width: 400px;
        font-size: 1rem;
    }
    input#topicSearch {
        padding: 10px;
        margin-bottom: 15px;
        width: 100%;
        max-width: 400px;
        font-size: 1rem;
    }

    .topic-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-width: 600px;
    }

    .topic-card {
        background-color: #f9f9f9;
        padding: 12px 16px;
        border: 1px solid #ddd;
        border-radius: 6px;
        transition: 0.2s ease-in-out;
    }

        .topic-card:hover {
            background-color: #eef6ff;
            border-color: #007bff;
        }

        .topic-card a {
            font-size: 1rem;
            color: #007bff;
            text-decoration: none;
        }

        .topic-card button {
            margin-left: 8px;
            padding: 6px 12px;
            font-size: 0.9rem;
            border: none;
            background-color: #007bff;
            color: white;
            border-radius: 4px;
            cursor: pointer;
        }


            .topic-card button:hover {
                background-color: #0056b3;
            }
</style>

<script>
    function filterAvailable() {
        const input = document.getElementById("topicSearch").value.toLowerCase();
        const cards = document.querySelectorAll("#topicList .topic-card");

        cards.forEach(card => {
            const topicText = card.textContent.toLowerCase();
            card.style.display = topicText.includes(input) ? "block" : "none";
        });
    }

    function filterSubscribed() {
        const input = document.getElementById("subscribedSearch").value.toLowerCase();
        const cards = document.querySelectorAll("#subscribedList .topic-card");

        cards.forEach(card => {
            const topicText = card.textContent.toLowerCase();
            card.style.display = topicText.includes(input) ? "block" : "none";
        });
    }
</script>