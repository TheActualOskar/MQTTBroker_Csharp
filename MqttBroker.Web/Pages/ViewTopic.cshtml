@page
@model MqttBroker.Web.Pages.ViewTopicModel
@{
    ViewData["Title"] = "Live Topic Viewer";
}

<h2>Live View: @Model.Topic</h2>

<div id="messages" class="message-box">
    <p><i>Waiting for messages...</i></p>
</div>

<style>
    .message-box {
        margin-top: 20px;
        padding: 15px;
        background-color: #f5f5f5;
        border: 1px solid #ccc;
        border-radius: 6px;
        max-height: 400px;
        overflow-y: auto;
        font-family: monospace;
    }

        .message-box p {
            margin: 5px 0;
        }
</style>

<script>
    const topic = "@Model.Topic";
    const socket = new WebSocket("ws://localhost:9001");

    socket.onopen = () => {
        console.log("🔗 WebSocket connected");
        socket.send(topic); // Tell the broker which topic to subscribe to
    };

    socket.onmessage = (event) => {
        const msgBox = document.getElementById("messages");
        const p = document.createElement("p");
        p.textContent = "📨 " + event.data;
        msgBox.appendChild(p);
        msgBox.scrollTop = msgBox.scrollHeight; // Auto-scroll
    };

    socket.onclose = () => {
        console.warn("❌ WebSocket closed");
    };
</script>
