@page
@model MqttBroker.Web.Pages.CreateTopicModel
@using MqttBroker.Web.Services
@inject SubscriptionService SubscriptionService

<h2 class="text-2xl font-semibold mb-4">Create New SmartFilter</h2>

<form method="post" class="space-y-4 bg-white p-6 rounded-xl shadow-md">
    <fieldset>
        <legend class="text-lg font-bold mb-2">Step 1: Browse & Filter Streams</legend>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="Filter.Building" class="block font-medium">Building</label>
                <select asp-for="Filter.Building"
                        asp-items="@(new MultiSelectList(Model.AvailableBuildings))"
                        class="form-select w-full" multiple></select>
            </div>
            <div>
                <label asp-for="Filter.Room" class="block font-medium">Room</label>
                <select asp-for="Filter.Room"
                        asp-items="@(new MultiSelectList(Model.AvailableRooms))"
                        class="form-select w-full" multiple></select>
            </div>

            <div>
                <label asp-for="Filter.SensorType" class="block font-medium">Sensor Type</label>
                <select asp-for="Filter.SensorType"
                        asp-items="@(new MultiSelectList(Model.AvailableSensorTypes))"
                        class="form-select w-full" multiple></select>
            </div>

            <div class="col-span-2">
                <label class="block font-medium">Thresholds per Sensor Type</label>
                <div class="space-y-2">
                    <div class="flex items-center space-x-2">
                        <span class="w-32">Temperature</span>
                        <select name="TempThresholdOperator" class="form-select">
                            <option value=">">&gt;</option>
                            <option value="<">&lt;</option>
                            <option value="=">=</option>
                        </select>
                        <input name="TempThresholdValue" type="number" step="0.1" class="form-input w-24" />
                    </div>
                    <div class="flex items-center space-x-2">
                        <span class="w-32">Humidity</span>
                        <select name="HumidityThresholdOperator" class="form-select">
                            <option value=">">&gt;</option>
                            <option value="<">&lt;</option>
                            <option value="=">=</option>
                        </select>
                        <input name="HumidityThresholdValue" type="number" step="0.1" class="form-input w-24" />
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 flex items-center space-x-4">
            <label class="inline-flex items-center">
                <input type="checkbox" asp-for="Filter.ActiveOnly" class="form-checkbox mr-2" />
                Only show active streams
            </label>
            <button type="submit" name="action" value="preview" class="btn btn-secondary" formnovalidate>Preview Matching Streams</button>
        </div>
    </fieldset>

    @if (Model.PreviewResults != null)
    {
        <div class="mt-6">
            <h3 class="text-lg font-semibold">Preview Results</h3>
            <p class="text-sm text-gray-700">
                @Model.PreviewResults.Total matches —
                @Model.PreviewResults.Active active,
                @Model.PreviewResults.Inactive inactive
            </p>

            <table class="table-auto w-full mt-2 border">
                <thead class="bg-gray-200">
                    <tr>
                        <th class="px-4 py-2">Stream ID</th>
                        <th class="px-4 py-2">Location</th>
                        <th class="px-4 py-2">Type</th>
                        <th class="px-4 py-2">Last Seen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stream in Model.PreviewResults.Streams)
                    {
                        <tr>
                            <td class="border px-4 py-2">@stream.StreamId</td>
                            <td class="border px-4 py-2">@stream.Location</td>
                            <td class="border px-4 py-2">@stream.Type</td>
                            <td class="border px-4 py-2">@stream.LastSeen</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <fieldset class="mt-6">
        <legend class="text-lg font-bold mb-2">Step 2: Save SmartFilter</legend>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="Input.Name" class="block font-medium">Filter Name</label>
                <input asp-for="Input.Name" class="form-input w-full" />
            </div>
            <div>
                <label asp-for="Input.Description" class="block font-medium">Description</label>
                <input asp-for="Input.Description" class="form-input w-full" />
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" name="action" value="create" class="btn btn-primary">Save SmartFilter</button>
        </div>
    </fieldset>

    @if (Model.Result != null)
    {
        <div class="alert alert-success mt-3">
            SmartFilter created: <strong>@Model.Result.Name</strong> — @Model.Result.CurrentMatchCount streams
        </div>
    }
</form>
