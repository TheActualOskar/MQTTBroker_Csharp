@page
@model MqttBroker.Web.Pages.AdminDashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2>Welcome Admin, @Model.Username 👋</h2>

<hr />

<h3>Add New Datastream</h3>

<form method="post" class="datastream-form">
    <div class="form-group">
        <label>Device ID:</label>
        <input type="text" name="DeviceId" required />
    </div>
    <div class="form-group">
        <label>Datastream ID:</label>
        <input type="text" name="DatastreamId" required />
    </div>
    <div class="form-group">
        <label>Unit:</label>
        <input type="text" name="Unit" required />
    </div>
    <div class="form-group">
        <label>Frequency:</label>
        <input type="text" name="Frequency" required />
    </div>
    <div class="form-group">
        <label>Topic Name:</label>
        <input type="text" name="TopicName" required />
    </div>
    <div class="form-actions">
        <button type="submit">➕ Create Datastream</button>
    </div>
</form>

<hr />

@if (Model.Topics.Any())
{
    <h3>Existing Topics:</h3>
    <ul>
        @foreach (var topic in Model.Topics)
        {
            <li>@topic</li>
        }
    </ul>
}
else
{
    <p>No topics found in Neo4j.</p>
}

<style>
    .datastream-form {
        max-width: 500px;
        padding: 20px;
        background-color: #f7f7f7;
        border-radius: 8px;
        border: 1px solid #ddd;
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .form-group input[type="text"] {
            width: 100%;
            padding: 8px;
            font-size: 1rem;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

    .form-actions {
        margin-top: 10px;
    }

        .form-actions button {
            background-color: #007bff;
            color: white;
            padding: 8px 16px;
            border: none;
            border-radius: 4px;
            font-size: 1rem;
            cursor: pointer;
        }

            .form-actions button:hover {
                background-color: #0056b3;
            }
</style>
