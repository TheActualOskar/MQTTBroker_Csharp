@page
@model MqttBroker.Web.Pages.AdminDashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2>Welcome Admin, @Model.Username</h2>

<hr />

<h3>Add New Datastream</h3>

<form method="post" class="datastream-form">
    <div class="form-group">
        <label asp-for="DeviceId">Device ID:</label>
        <input asp-for="DeviceId" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="SelectedBuilding">Select Building:</label>
        <select asp-for="SelectedBuilding" class="form-control" required onchange="this.form.submit()">
            <option value="">-- Choose Building --</option>
            @foreach (var building in Model.AvailableBuildings)
            {
                <option value="@building">@building</option>
            }
        </select>
    </div>

    @{
        var isRoomDisabled = string.IsNullOrEmpty(Model.SelectedBuilding) ? "disabled" : "";
    }

    <div class="form-group">
        <label for="SelectedRoom">Select Room:</label>
        <select name="SelectedRoom" class="form-control" required @isRoomDisabled>
            <option value="">-- Choose Room --</option>
            @foreach (var room in Model.AvailableRooms)
            {
                <option value="@room" selected="@(room == Model.SelectedRoom ? "selected" : null)">
                    @room
                </option>
            }
        </select>
    </div>

    <div class="form-group">
        <label asp-for="SensorType">Sensor Type:</label>
        <select asp-for="SensorType" class="form-control" required>
            <option value="">-- Choose Sensor --</option>
            <option value="Temperature">Temperature</option>
            <option value="Humidity">Humidity</option>
        </select>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">➕ Create Datastream</button>
    </div>
</form>

<hr />

@if (Model.Topics.Any())
{
    <h3>Existing Topics:</h3>
    <ul>
        @foreach (var topic in Model.Topics)
        {
            <li>@topic</li>
        }
    </ul>
}
else
{
    <p>No topics found in Neo4j.</p>
}

<hr />

<h3>Admin Tools</h3>

@if (TempData["Message"] != null)
{
    <p class="status-message @(TempData["Message"].ToString().Contains("success") ? "success" : "error")">
        @TempData["Message"]
    </p>
}

<form method="post" asp-page-handler="RefreshVirtualTopics">
    <button type="submit" class="btn btn-secondary">🔄 Refresh Virtual Topics</button>
</form>

<style>
    .datastream-form {
        max-width: 500px;
        padding: 20px;
        background-color: #f7f7f7;
        border-radius: 8px;
        border: 1px solid #ddd;
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .form-group input[type="text"],
        .form-group select {
            width: 100%;
            padding: 8px;
            font-size: 1rem;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

    .form-actions {
        margin-top: 10px;
    }

        .form-actions button {
            background-color: #007bff;
            color: white;
            padding: 8px 16px;
            border: none;
            border-radius: 4px;
            font-size: 1rem;
            cursor: pointer;
        }

            .form-actions button:hover {
                background-color: #0056b3;
            }

    .status-message {
        padding: 10px;
        margin: 10px 0;
        border-radius: 4px;
        font-weight: bold;
    }

        .status-message.success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .status-message.error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
</style>
